# ============================================================
# Dockerfile.api — UsiEdu API (Python 3.12 + FastAPI)
# ============================================================
FROM python:3.12-slim AS builder

WORKDIR /app

# Instala dependências do sistema e atualizações de segurança
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copia manifestos e código fonte para hatchling construir o pacote
COPY pyproject.toml README.md ./
COPY src/ ./src/

# Instala dependências e pacote com remedições do Trivy
RUN pip install --no-cache-dir --upgrade pip "setuptools>=78.1.1" && \
    pip install --no-cache-dir . && \
    rm -rf /usr/local/lib/python3.12/site-packages/pip/_vendor/bom.cdx.json

# ============================================================
FROM python:3.12-slim AS runtime

WORKDIR /app

# Instala atualizações de segurança no runtime
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

# Copia dependências do builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copia o código
COPY src/ ./src/
COPY knowledge_base/ ./knowledge_base/
COPY scripts/ ./scripts/

# Porta da API
EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Comando de inicialização
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
