# ============================================================
# Dockerfile.frontend — UsiEdu Frontend (React + Vite)
# ============================================================
FROM node:20-alpine AS builder

WORKDIR /app

RUN apk upgrade --no-cache

# Copia arquivos de configuração
COPY frontend/package.json frontend/package-lock.json* ./

# Instala dependências
RUN npm ci

# Copia o código fonte
COPY frontend/ ./

# Build de produção
RUN npm run build

# ============================================================
FROM nginx:alpine AS runtime

# Atualiza pacotes do sistema com patches de segurança (libcrypto3, libssl3)
RUN apk upgrade --no-cache

# Copia o build do Vite para o nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# O entrypoint oficial do nginx processa o template com envsubst. No Docker
# local usa http://api:8000; no Azure recebe http://<container-app-api>.
ENV UPSTREAM_API_URL=http://api:8000
COPY frontend/nginx/default.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
