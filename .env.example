# LLM — provider ativo
USIEDU_LLM_PROVIDER=opencode-go        # opencode-go | gemini
OPENCODE_GO_API_KEY=                    # chave da assinatura OpenCode Go
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
USIEDU_ROUTER_MODEL=deepseek-v4-flash   # supervisor/roteamento
USIEDU_AGENT_MODEL=kimi-k2.7-code       # agentes/consolidação
# Gemini (opcional, stub)
GOOGLE_APPLICATION_CREDENTIALS=

# Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_ACADEMICO=academico
QDRANT_COLLECTION_INSTITUCIONAL=institucional

# Auth
JWT_SECRET=                             # gerar: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_EXPIRES_MINUTES=60

# Observabilidade
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=usiedu-pilot

# Modelos locais
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=BAAI/bge-reranker-base

# App
USIEDU_ENV=dev                          # dev | test | prod
LOG_LEVEL=INFO

# Rate limiting (T9.1) — formato slowapi: N/segundo|minute|hour|day
USIEDU_RATE_CHAT=10/minute              # /chat e /chat/stream, por usuário
USIEDU_RATE_LOGIN=5/minute              # /auth/login, por IP
USIEDU_RATE_FEEDBACK=30/minute          # /feedback, por usuário

# Cache semântico do chat (T9.2)
USIEDU_CACHE_ENABLED=true               # false desativa o cache por completo
USIEDU_CACHE_DB=usiedu_cache.db         # caminho do SQLite do cache
USIEDU_CACHE_SIMILARITY=0.97            # limiar de cosseno do hit semântico
USIEDU_CACHE_TTL_DAYS=30                # validade das entradas (dias)
