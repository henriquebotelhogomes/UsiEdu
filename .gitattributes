# ==============================================================================
# .gitattributes — UsiEdu
# Configuração de Binários e GitHub Linguist (Estatísticas de Linguagem)
# ==============================================================================

# Definições de Binários
knowledge_base/* binary

# GitHub Linguist: Ignorar base de conhecimento bruta e documentação compilada
# Isso garante que as estatísticas do repositório destaquem Python e TypeScript
knowledge_base/** linguist-documentation
knowledge_base/** linguist-vendored
knowledge_base/** linguist-detectable=false
knowledge_base/*.html linguist-documentation
knowledge_base/*.html linguist-vendored
knowledge_base/*.html linguist-detectable=false

# Documentação MkDocs e site compilado
site/** linguist-vendored
site/** linguist-documentation
docs/** linguist-documentation
docs/** linguist-vendored

# Builds estáticos do Frontend e fixtures de teste
frontend/dist/** linguist-vendored
frontend/dist/** linguist-detectable=false
tests/fixtures/*.html linguist-vendored
tests/fixtures/*.html linguist-detectable=false
